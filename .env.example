# Parakh - Environment Configuration Template
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), add these variables in your Project Settings > Environment Variables.

# MongoDB Connection String
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-url>/parakh?retryWrites=true&w=majority
# For local MongoDB: mongodb://127.0.0.1:27017/parakh
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/parakh?retryWrites=true&w=majority

# JSON Web Token Secret
# Generate a strong 32+ character random secret for signing authentication cookies
# Example: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret
